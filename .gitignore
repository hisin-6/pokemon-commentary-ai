# 仮想環境
venv/

# Pythonキャッシュ
__pycache__/
*.pyc
*.pyo

# EasyOCRモデルキャッシュ
.EasyOCR/

# デバッグ用スクショ（screen_capture.pyが自動生成）
debug/

# パイプラインログ（pipeline.pyが自動生成）
logs/

# 実況動画レンダリング素材・出力（--render-out とパス2が生成・mp4は数GB）
renders/

# PokeAPI キャッシュ（336MB、scripts/build_pokedb.pyが生成）
data/pokeapi_cache/

# PokeDB（build_pokedb.pyで再生成可能なバイナリ）
data/pokedb.sqlite

# VS Code ワークスペース設定
.vscode/

# テスト・学習用画像（大きいのでGit管理しない）
data/test_images/ocr/*.png
data/test_images/ocr/*.jpg
data/test_images/diff_detection/*.png
data/test_images/diff_detection/*.jpg
data/yolo_dataset/images/**/*.png
data/yolo_dataset/images/**/*.jpg
data/yolo_dataset/labels/**/*.txt

# ただしREADMEは含める
!data/**/README.md

# 環境変数・秘密情報
.env
*.key

# YOLOv8 学習出力（モデルウェイト・ログ等）
runs/

# PyTorch モデルウェイト（自動DLされるもの・学習済みモデル）
*.pt

# ボール検出専用データセット（画像は大容量・ラベルは再生成可能）
data/ball_dataset/images/
data/ball_dataset/labels/
data/ball_dataset/deleted_bg_labels.txt

# Label Studio エクスポート（メールアドレス等の個人情報を含む可能性あり）
annotations.json
annotations_balls.json

# パイプライン実行ログ
records/

# 終了画面学習データセット（画像バイナリ・data.yamlは管理対象）
data/end_screen_dataset/images/
data/end_screen_dataset/labels/
data/end_screen_dataset/raw/

# EasyOCR ファインチューニング用データ（大容量・再生成可能）
data/ocr_crop/
data/ocr_crops/
data/ocr_lmdb/

# ファインチューニング用モデルウェイト
pretrained/
saved_models/

# サードパーティ学習フレームワーク（deep-text-recognition-benchmark）
tools/deep-text-recognition-benchmark/

# 一時ファイル
tmp/

# Claude Code 設定・メモリ（skills はプロジェクト知識としてGit管理する）
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db

docs/manual/bedrock-haiku-4-5-migration.md

# キャラクター外注ドキュメント（予算・交渉戦略・相談文を含むため公開リポジトリに載せない）
docs/design/character-commission-spec.md
docs/design/character-commission-messages.md
data/voices/

# 外部データ取得スクリプト（非公開・ローカル運用のみ）
scripts/update_champions_roster.py
tests/test_update_champions_roster.py

# モーションデータ（CMU BVH等・外部配布物のためGit管理しない）
data/mocap/

# MMDモーションデータ（VMD・外部配布物のためGit管理しない）
data/vmd/

# BVH/VMDモーション変換の検証スクリプト（2026-08-02・方針によりGit非公開）
scripts/explore_bvh_motion.py
scripts/explore_vmd_motion.py
scripts/pmx_bone_reader.py
scripts/vrm_bone_reader.py
scripts/compute_vmd_retarget_correction.py
scripts/compute_bone_local_frames.py
